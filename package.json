{
  "name": "har-to-mocks",
  "version": "0.0.0",
  "type": "module",
  "description": "Extract response from .har file and create JSON mocks for mock server.",
  "author": "Peter Knezek @peterknezek",
  "bin": {
    "har-to-mocks": "./bin/run"
  },
  "bugs": "https://github.com/peterknezek/har-to-mocks/issues",
  "dependencies": {
    "@inquirer/ansi": "^2.0.7",
    "@inquirer/core": "^11.2.1",
    "@inquirer/figures": "^2.0.7",
    "@inquirer/prompts": "^8.5.2",
    "@oclif/core": "^4.11.4",
    "update-notifier": "^7.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@oclif/plugin-help": "^6.2.50",
    "@oclif/table": "^0.5.9",
    "@oclif/test": "^4.1.18",
    "@types/archy": "^0.0.36",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.9.3",
    "@types/update-notifier": "^6.0.8",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitest/ui": "^4.1.8",
    "archy": "^1.0.0",
    "chai": "^6.2.2",
    "esbuild": "^0.27.7",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^17.6.0",
    "oclif": "^4.23.14",
    "prettier": "^3.8.4",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "minimatch": "^10.2.1",
    "flatted": "^3.4.2",
    "vite": "^8.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "/bin",
    "/lib"
  ],
  "homepage": "https://github.com/peterknezek/har-to-mocks",
  "keywords": [
    "cli",
    "har",
    "mocks",
    "mock",
    "testing",
    "mocking",
    "requests",
    "connect-api-mocker"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "oclif": {
    "bin": "har-to-mocks",
    "dirname": "har-to-mocks",
    "commands": {
      "strategy": "single",
      "target": "./lib/index.js"
    },
    "additionalHelpFlags": [
      "-h"
    ],
    "additionalVersionFlags": [
      "-v"
    ]
  },
  "repository": "peterknezek/har-to-mocks",
  "scripts": {
    "prepack": "npm run build",
    "build": "rm -rf lib && node esbuild.config.js",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:ui": "vitest --ui",
    "har-to-mocks": "bin/run",
    "lint": "eslint \"src/**/*.{js,ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{js,ts,tsx}\" --fix"
  },
  "release": {
    "branches": [
      "master",
      "next"
    ]
  }
}
